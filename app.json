{
  "expo": {
    "name": "Arokya Shop Manager",
    "slug": "arokya-shop-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": null,
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A6B3C",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arokya.shopmanager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A6B3C"
      },
      "package": "com.arokya.shopmanager",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-file-system",
      "expo-document-picker"
    ],
    "experiments": {
      "newArchEnabled": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6c49ca4f-44ee-4704-be79-7c7cb363a4db"
      }
    }
  }
}
