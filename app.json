{
  "expo": {
    "name": "Arokya Shop Manager",
    "slug": "arokya-shop-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A6B3C",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arokya.shopmanager"
    },
    "android": {
      "package": "com.arokya.shopmanager",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-file-system",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "useHermesV1": true,
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6c49ca4f-44ee-4704-be79-7c7cb363a4db"
      }
    }
  }
}
